  "description": "Tiny hills above the prompt, one per metric a session is hillclimbing, showing how far up each is; hover one for details and an outside read on whether there is more to climb",
  "author": {
    "name": "Scott Smerchek",
    "url": "https://github.com/smerchek"
  },
  "license": "MIT",
  "repository": "https://github.com/smerchek/agent-plugins",
  "keywords": [
    "hillclimb",
    "optimization",
    "progress",
    "mod"
  ],
  "extensions": {
    "com.anthropic.claude-code": {
      "displayName": "Hills",
      "category": "productivity",
      "types": "./types/index.d.ts"
    }
  }
}
